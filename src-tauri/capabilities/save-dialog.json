{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "save-dialog",
  "description": "Allow the main window to use the dialog save prompt and write files selected by the user.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "**"
        }
      ]
    }
  ]
}
